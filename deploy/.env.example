# Description: Example environment file for LogicMonitor MCP server Docker deployment.
# Description: Copy to .env and fill in your values.

# Required: LogicMonitor portal hostname
LM_PORTAL=yourcompany.logicmonitor.com

# Authentication (choose one):
# Option 1: Bearer token (recommended)
LM_BEARER_TOKEN=your-bearer-token

# Option 2: LMv1 HMAC credentials (required for ingestion APIs)
# LM_ACCESS_ID=your-access-id
# LM_ACCESS_KEY=your-access-key

# Server Configuration
LM_HTTP_PORT=8080
LM_ENABLE_WRITE_OPERATIONS=false
LM_CORS_ORIGINS=

# Require this bearer token on /mcp and /api/v1/* (minimum 16 characters).
# Strongly recommended whenever the port is reachable beyond localhost.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LM_HTTP_AUTH_TOKEN=

# Session Configuration
LM_SESSION_ENABLED=true

# Field Validation: off, warn, or error
LM_FIELD_VALIDATION=warn

# TLS Configuration (for Caddy profile)
# DOMAIN=lm-mcp.example.com

# Multi-portal mode (LM_MULTI_PORTAL) is stdio-only and not available in this
# HTTP deployment; the server refuses to start it on LM_TRANSPORT=http.
