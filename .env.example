# LogicMonitor MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your LogicMonitor portal hostname
LM_PORTAL=yourcompany.logicmonitor.com

# Required: Bearer token for authentication
LM_BEARER_TOKEN=your_bearer_token

# Optional settings
LM_TIMEOUT=30
LM_ENABLE_WRITE_OPERATIONS=false
LM_MAX_RETRIES=3
# Longest wait between retries; a server's Retry-After can lengthen the backoff up to it
LM_RETRY_AFTER_CAP_SECONDS=120

# Multi-portal mode (optional, stdio-only — one server, many customer portals)
# LM_MULTI_PORTAL=true
# LM_VAULT_FILE=~/.config/lm-mcp/secrets.age
# LM_AGE_KEY=~/.config/lm-mcp/age-key.txt
# LM_PORTALS_FILE=/path/to/portals.json   # plaintext alternative, testing only

# HTTP transport (optional; stdio is the default)
# LM_TRANSPORT=http
# LM_HTTP_HOST=127.0.0.1
# A non-loopback LM_HTTP_HOST needs LM_HTTP_AUTH_TOKEN (minimum 16 characters),
# or LM_HTTP_ALLOW_UNAUTHENTICATED=true for a listener protected another way
# (an authenticating proxy, a private network); otherwise the server refuses to start.
# LM_HTTP_AUTH_TOKEN=
# LM_HTTP_ALLOW_UNAUTHENTICATED=false
# Host names every route except /healthz and /readyz accepts besides loopback
# and LM_HTTP_HOST
# LM_HTTP_ALLOWED_HOSTS=mcp.example.com

# Edwin AI (optional; off unless both credentials are set)
# Client id and secret of an Edwin AI API credential
# EDWIN_CLIENT_ID=
# EDWIN_CLIENT_TOKEN=
# Edwin base URL, https only; defaults to https://<portal name>.dexda.ai
# EDWIN_HOST=https://yourcompany.dexda.ai
# A second, read-scope Edwin credential, for the scope-gate probe only (optional)
# EDWIN_CLIENT_ID_PROBE=
# EDWIN_CLIENT_TOKEN_PROBE=
